# ==============================================================================
# BH PLANNER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local and populate with your credentials
# ==============================================================================

# 1. Google Gemini API (Primary AI Engine: gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cohere API (Fallback AI Engine: command-r-08-2024)
COHERE_API_KEY=your_cohere_api_key_here

# 3. Supabase Configuration (PostgreSQL Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
